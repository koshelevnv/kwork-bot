# Токен вашего Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123:ABC

# ID администраторов бота через запятую (ваш Telegram user_id)
# Узнать свой ID можно у @userinfobot
ADMIN_IDS=123456789

# Категории, которые проставляются новому пользователю при первой регистрации
# (ID из URL kwork.ru/projects?c=41). Дальше меняются кнопками в боте.
# Оставить пустым — будут приходить заказы из всех разделов.
KWORK_CATEGORIES=41,39

# Интервал проверки новых заказов в секундах.
# Применяется при создании базы; потом меняется администратором в боте.
POLL_INTERVAL_SECONDS=30
